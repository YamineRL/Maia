<?xml version="1.0" encoding="utf-8"?>
<!--
    Static launcher shortcuts. Brief section 5.

    Static rather than dynamic, and no ShortcutManager code: dynamic shortcuts
    exist for content that changes, and this does not.

    Two shortcuts. M3 shipped new_event alone, because a "Quick note" door
    leading to "notes arrive at M4" would have been a door painted on a wall.
    M4 hangs it: docs/M4-brief.md section 5.4. The note door carries a hint
    about which door it is and never changes what a sentence means.

    The id and the action are a contract with launchers from the day they ship,
    because a user who pins this to a home screen holds the id. Item I3. They
    are not renamed without breaking every pin.

    The target is not exported, and that is allowed: see the kdoc on
    InvokeActivity and docs/research/R5.md. The action attribute is mandatory on
    a static shortcut's intent, and this element cannot use string resources for
    it, which is why each action is spelled out here as well as in
    InvokeActions.NEW_EVENT and InvokeActions.QUICK_NOTE. ShortcutsXmlTest asserts every action declared here
    routes, so the two spellings cannot drift apart in silence.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_tile_maia"
        android:shortcutId="new_event"
        android:shortcutLongLabel="@string/shortcut_new_event_long"
        android:shortcutShortLabel="@string/shortcut_new_event_short">
        <intent
            android:action="dev.maia.app.action.NEW_EVENT"
            android:targetClass="dev.maia.app.assist.InvokeActivity"
            android:targetPackage="dev.maia.app" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_tile_maia"
        android:shortcutId="quick_note"
        android:shortcutLongLabel="@string/shortcut_quick_note_long"
        android:shortcutShortLabel="@string/shortcut_quick_note_short">
        <intent
            android:action="dev.maia.app.action.QUICK_NOTE"
            android:targetClass="dev.maia.app.assist.InvokeActivity"
            android:targetPackage="dev.maia.app" />
    </shortcut>
</shortcuts>
