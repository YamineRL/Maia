    <string name="m8_list_stale_note">This is the last list Maia had. A project added since will be missing from it.</string>
    <string name="m8_list_stale_no_registry_note">This is the last list Maia had. Your machine answered just now and has nothing to send, so trying again will not bring a newer one. The list is built at that end by:</string>

