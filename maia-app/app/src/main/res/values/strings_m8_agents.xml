    <!-- ================================================ the status labels
         The orb's text twin, and mandatory at every size on the run screen
         (section 1.1): below widget size the form is never the sole indicator.
         This is also the screen's one live region, polite, announcing at most
         five state changes across a four-minute run (section 6.1).

         The eight words are verbatim from section 6.3, which writes them in
         full and in order: SENDING, SENT, WORKING, QUEUED, WAITING FOR YOU,
         FINISHED, STOPPED, DID NOT FINISH. The ids are not: section 10 defines
         none for them, which is the one gap in that document this screen could
         not be drawn around, and it is reported rather than resolved by
         rewording anything. If the design seat names them differently, these
         eight lines are the only ones that change.

         "Waiting for you" is two words longer than "blocked" and is the one a
         person understands without being told what it means. All constant, no
         counts and no timers, written to be heard as well as seen. -->
    <string name="m8_run_status_sending">SENDING</string>
    <string name="m8_run_status_sent">SENT</string>
    <string name="m8_run_status_working">WORKING</string>
    <string name="m8_run_status_queued">QUEUED</string>
    <string name="m8_run_status_waiting_for_you">WAITING FOR YOU</string>
    <string name="m8_run_status_finished">FINISHED</string>
    <string name="m8_run_status_stopped">STOPPED</string>
    <string name="m8_run_status_did_not_finish">DID NOT FINISH</string>

